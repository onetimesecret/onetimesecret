# Lane: full-sqlite — full auth mode against in-memory SQLite.
# CI jobs: ruby-integration-full (T3, "SQLite" row) on every Ruby change;
# ruby-integration-billing (the same lane with the billing overlay) when
# billing is selected.
#
# NOTE: lib/tasks/spec.rake hardcodes AUTH_DATABASE_URL/ORGS_SSO_ENABLED
# for this task as a defense against ambient env. Keeping identical values
# here is intentional: the lane is correct standalone (e.g. running rspec
# by hand from this directory), and rake's override is a no-op.
AUTHENTICATION_MODE=full
AUTH_DATABASE_URL='sqlite::memory:'
ORGS_SSO_ENABLED=true
# The install-wide SAML switch (#4604), default off: the tenant saml route
# (placeholder or platform) registers only with it on.
SAML_ENABLED=true

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). spec/spec_helper.rb refuses to boot
# with an empty generated/locales, so every lane that runs Ruby specs
# declares it.
LANES_CODEGEN='locales'
