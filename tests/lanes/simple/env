# Lane: simple — integration specs for AUTHENTICATION_MODE=simple.
# CI job: ruby-integration-simple (T3)
AUTHENTICATION_MODE=simple

# Four rspec workers for spec:integration:simple (parallel_rspec in
# lib/tasks/spec.rake), one valkey index each; the tryouts leg stays serial
# on the lane's own index (#4551). --workers 1 is the serial run.
LANES_WORKERS=4

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). spec/spec_helper.rb refuses to boot
# with an empty generated/locales, so every lane that runs Ruby specs
# declares it.
LANES_CODEGEN='locales'
