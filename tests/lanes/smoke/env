# Lane: smoke — representative cross-stack check (about 10.5 min on CI).
# Cleans the TEST valkey (2163), runs smoke:ruby, then the vitest smoke
# subset (pnpm test:smoke:vitest; list in src/tests/smoke-files.ts).
# CI: run by the T3 smoke-test job in .github/workflows/ci.yml when a
# change touches both Ruby and TypeScript, with timeout-minutes 15. The
# Ruby part takes about 9 minutes of that.
AUTHENTICATION_MODE=simple

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). smoke:ruby includes
# spec:apps:web_billing, which reads the gitignored generated billing
# schema; spec/spec_helper.rb needs the compiled locales.
#
# NOT skip-safe: `pnpm test:smoke` shells into `pnpm test:smoke:vitest`,
# which starts with its own `pnpm run locales:sync` (package.json).
# --skip-codegen silences the phase below but not that one, so this lane
# must stay out of any parallel set that relies on the flag to keep
# generated/ still.
LANES_CODEGEN='locales schemas'
