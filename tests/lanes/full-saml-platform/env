# Lane: full-saml-platform — full auth mode with the PLATFORM SAML provider
# configured from the environment (#4450), against in-memory SQLite.
#
# Own process on purpose: Auth::Config configures once per process and
# configure_provider reads SAML_* at that moment, so a SAML_IDP_ENTITY_ID
# here would flip the full-sqlite/full-pg lanes — where the saml route is
# the tenant PLACEHOLDER (blank trust anchors) and the tenant e2e asserts
# the canonical host answers 404 / refuses — from green to red.
# CI job: ruby-integration-full (T3, "SQLite, platform SAML" matrix row)
#
# SAML_IDP_CERT is deliberately NOT here. The spec mints the IdP keypair at
# load time (spec/support/saml/test_idp.rb — no key material is checked in;
# the pre-commit hook refuses private keys) and installs the matching PEM in
# ENV before the first boot. The three public strings below are what the
# lane provides; the spec is tagged `lane_env:` on SAML_IDP_ENTITY_ID.
#
# NOTE: lib/tasks/spec.rake hardcodes these values for the task as a
# defense against ambient env. Keep identical.
#
# LIMIT (#4223): the platform host in this lane is the IP-literal site.host
# of spec/config.test.yaml ('127.0.0.1:3000'). No variable here can change
# it, Rack::DetectHost accepts no IP literal, and the platform ACS is fixed
# at boot. So this lane cannot put a Host-rewriting proxy in front of the
# PLATFORM host, and PUBLIC_HOST_REWRITE never rewrites a platform request
# here. The full reasoning, and what covering it would take, is under
# KNOWN LIMIT in the header of platform_saml_sso_spec.rb.
AUTHENTICATION_MODE=full
AUTH_DATABASE_URL='sqlite::memory:'
ORGS_SSO_ENABLED=true
# The install-wide SAML switch (#4604), default off: the tenant saml route
# (placeholder or platform) registers only with it on.
SAML_ENABLED=true
# Platform SSO on: MockAuthConfig#sso_enabled? honours this, and it gates the
# platform IdP-origin set HttpOriginOptions admits for the POST callback.
AUTH_SSO_ENABLED=true
SAML_IDP_SSO_SERVICE_URL='https://login.platform-idp.test/saml/sso'
SAML_IDP_ENTITY_ID='https://platform-idp.test/saml/metadata'
# The SAML-compatible session cookie: Secure with same_site lax or none.
# lax is the app default and the policy the staged POST -> 303 -> GET
# callback transport is designed to recover; none remains supported.
# Saml.platform_options refuses strict or a non-Secure cookie, so without
# these two the platform provider is SKIPPED at boot and every example above
# fails on "is the saml route the placeholder?". spec/config.test.yaml reads
# them; the spec's requests are https:// so Rack::Test returns the Secure
# cookie.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=true

# Generated prerequisites, produced by tests/lanes/run before the tasks below.
LANES_CODEGEN='locales'
