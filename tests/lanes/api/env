# Lane: api — API contract specs (spec/api), an axis separate from auth
# mode. Needs only Valkey.
# CI: blocking step in ruby-integration-simple (T3), via the
# run-test-lane composite (was non-blocking while the #3225 drift was
# red). Gating policy (blocking or not) is CI's decision, not the
# lane's; the lane just defines the run.
AUTHENTICATION_MODE=simple

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). spec/spec_helper.rb refuses to boot
# with an empty generated/locales, so every lane that runs Ruby specs
# declares it.
LANES_CODEGEN='locales'
