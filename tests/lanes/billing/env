# Lane: billing — the billing app's specs and tryouts, plus the root test
# trees named for billing (spec/unit/billing, spec/cli/billing,
# spec/unit/onetime/operations/billing, try/unit/billing, try/unit/cli/billing).
# Carved out of the unit lane; same environment, its own process and CI job.
# CI job: ruby-billing (T2)
#
# Not the billing OVERLAY. `--overlay billing` turns billing on for the
# full-mode lanes (ruby-integration-billing); this lane runs billing's own
# specs, which stub the billing configuration themselves and replay committed
# VCR cassettes, in simple mode with billing off like the unit lane they came
# from.
AUTHENTICATION_MODE=simple

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). spec/spec_helper.rb refuses to boot
# with an empty generated/locales, and the billing catalog specs read the
# gitignored generated/schemas/config/billing.schema.json.
LANES_CODEGEN='locales schemas'
