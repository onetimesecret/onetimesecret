# Lane: full-pg-agnostic — DB-agnostic full-mode specs run against
# PostgreSQL (catches SQLite/PG behavior drift in specs that claim to be
# database-neutral).
# CI jobs: ruby-integration-auth (T3, "PG agnostic" row), selected by auth;
# ruby-integration-billing (the same lane with the billing overlay), nightly
# only.
#
# Same database env as full-pg; see that lane for where roles come from.
AUTHENTICATION_MODE=full
ORGS_SSO_ENABLED=true
# The install-wide SAML switch (#4604), default off: the tenant saml route
# (placeholder or platform) registers only with it on.
SAML_ENABLED=true
AUTH_DATABASE_URL='postgresql://onetime_user:testpass@127.0.0.1:2154/onetime_auth_test'
AUTH_DATABASE_URL_MIGRATIONS='postgresql://onetime_migrator:migratepass@127.0.0.1:2154/onetime_auth_test'
AUTH_DATABASE_URL_PG='postgresql://onetime_user:testpass@127.0.0.1:2154/onetime_auth_test'
AUTH_DATABASE_URL_MIGRATIONS_PG='postgresql://onetime_migrator:migratepass@127.0.0.1:2154/onetime_auth_test'

# Generated prerequisites, produced by tests/lanes/run before the tasks
# below (see the codegen phase there). spec/spec_helper.rb refuses to boot
# with an empty generated/locales, so every lane that runs Ruby specs
# declares it.
LANES_CODEGEN='locales'
