# Lane tasks: executed top-to-bottom from the repo root by tests/lanes/run
# (bash -euo pipefail: first failure stops the lane). Keep each line standalone.
#
# This lane runs no application code — it prints the environment it was
# handed, between markers, for spec/unit/lanes/hermetic_boundary_spec.rb
# to parse. Two sections, because a leaked exported function is visible
# in both forms and only the second one is the form that does damage:
#   - `env`        — surviving exported variables. A function that
#                    escaped the scrub appears here as a
#                    BASH_FUNC_<name>%% entry spanning several lines.
#   - `declare -F` — the same functions after bash re-materialized them
#                    in this process, which is what would shadow `git`,
#                    `bundle`, `docker`, or `rake` for a real lane.
echo '--- lane:selftest env ---'
env
echo '--- lane:selftest functions ---'
declare -F
echo '--- lane:selftest end ---'

# ── Runner-set env (#4492) ──────────────────────────────────────────────
# The runner exports the rspec status-file path below its scrub, keyed by
# lane and overlay set under tmp/lanes/. A keep-list or ordering slip that
# scrubbed the runner's own export would show up here, not in a real lane.
case "${LANES_RSPEC_STATUS_FILE:-}" in
  */tmp/lanes/selftest/base/rspec-status.txt) ;;
  *)
    echo "[lane:selftest] FAILED: LANES_RSPEC_STATUS_FILE='${LANES_RSPEC_STATUS_FILE:-}'" >&2
    exit 1
    ;;
esac
# last.log lives next to it, created and seeded with the banner before this
# process was exec'd; the epilogue is appending this very output to it.
if ! grep -q '^\[lane:selftest\] mode=simple ' tmp/lanes/selftest/base/last.log; then
  echo '[lane:selftest] FAILED: tmp/lanes/selftest/base/last.log missing or unseeded' >&2
  exit 1
fi

# ── Flag parsing (#4492) ────────────────────────────────────────────────
# Each row is `<expected exit> <argv>`, run as `tests/lanes/run selftest
# <argv>`. Every row carries --print-key, which returns right after the
# derivation and before any service, codegen or task — so the inner run
# never reaches this file again (no recursion) and needs nothing this lane
# does not already have. A parsing error (exit 64) fires before --print-key
# is honored, which is what makes the nonzero rows meaningful. The --only
# paths only have to exist; --print-key never opens them.
#
# `env -u RSPEC_OUTPUT_FILE`: the name is keep-listed, so a CI unit lane
# (results-file set by run-test-lane/action.yml) hands it to this process,
# and the boundary spec that drives this lane merges ENV rather than
# replacing it. The --quiet rows would then hit the runner's --quiet /
# RSPEC_OUTPUT_FILE refusal and read as a parsing regression. Unset, not
# emptied: the refusal tests -n. The one check that WANTS the pairing sets
# the name itself, below.
while read -r want args; do
  got=0
  # shellcheck disable=SC2086  # rows are split into argv on purpose
  env -u RSPEC_OUTPUT_FILE tests/lanes/run selftest ${args} >/dev/null 2>&1 || got=$?
  if [[ "${got}" != "${want}" ]]; then
    echo "[lane:selftest] FAILED: tests/lanes/run selftest ${args} exited ${got}, expected ${want}" >&2
    exit 1
  fi
done <<'ROWS'
0  --print-key
0  --quiet --print-key
64 --bogus --print-key
64 --print-key --bogus
64 --print-key -- --only-failures
0  --print-key --only spec/unit/lanes/hermetic_boundary_spec.rb -- --only-failures
0  --print-key --only spec/unit/lanes/hermetic_boundary_spec.rb --
64 --print-key --only try/unit/base_view_try.rb -- --only-failures
64 --print-key --only try/unit/base_view_try.rb --only spec/unit/lanes/hermetic_boundary_spec.rb
0  --console --print-key
0  --console --overlay billing --print-key
64 --console --only spec/unit/lanes/hermetic_boundary_spec.rb --print-key
64 --console --quiet --print-key
64 --console --skip-codegen --print-key
64 --console -- --only-failures
ROWS

# --quiet is an env effect, not an exit code: SPEC_OPTS must carry the quiet
# formatter under the flag and must be absent without it (default output is
# CI's output). RSPEC_OUTPUT_FILE is keep-listed, so the inner run sees it:
# unset for the first check (see the loop above), set on purpose for the
# third, which is the refusal itself.
if ! env -u RSPEC_OUTPUT_FILE tests/lanes/run selftest --quiet --print-key 2>/dev/null | grep -q 'spec_opts=--require .*quiet_formatter --format Lanes::QuietFormatter'; then
  echo '[lane:selftest] FAILED: --quiet did not set SPEC_OPTS to the quiet formatter' >&2
  exit 1
fi
if ! tests/lanes/run selftest --print-key 2>/dev/null | grep -q 'spec_opts=none$'; then
  echo '[lane:selftest] FAILED: SPEC_OPTS set without --quiet' >&2
  exit 1
fi
# Same shape for the app-log floor: LOG_LEVEL and a DEBUG_LOGGERS list with
# every entry at error under the flag, neither without it. Which names the
# list carries is pinned against the initializer's own logger table by
# spec/unit/lanes/quiet_log_floor_spec.rb (this lane runs no app code).
if ! env -u RSPEC_OUTPUT_FILE tests/lanes/run selftest --quiet --print-key 2>/dev/null | grep -qE '^log_level=error debug_loggers=([A-Za-z]+:error,)*[A-Za-z]+:error$'; then
  echo '[lane:selftest] FAILED: --quiet did not set LOG_LEVEL=error and DEBUG_LOGGERS=<name>:error,...' >&2
  exit 1
fi
if ! tests/lanes/run selftest --print-key 2>/dev/null | grep -q '^log_level=none debug_loggers=none$'; then
  echo '[lane:selftest] FAILED: LOG_LEVEL or DEBUG_LOGGERS set without --quiet' >&2
  exit 1
fi
got=0
RSPEC_OUTPUT_FILE=tmp/selftest-results.json tests/lanes/run selftest --quiet --print-key >/dev/null 2>&1 || got=$?
if [[ "${got}" != 64 ]]; then
  echo "[lane:selftest] FAILED: --quiet with RSPEC_OUTPUT_FILE exited ${got}, expected 64" >&2
  exit 1
fi
echo '--- lane:selftest flags ok ---'

# ── Path -> lane table (#4492) ──────────────────────────────────────────
# tests/lanes/ownership is the one table behind --which, lane inference and
# run-all --changed. Sourced here (the function table was printed above,
# so nothing below reaches the boundary spec's assertion) and checked three
# ways: against the tasks files, against the directories on disk, and
# through the two commands that read it.
# shellcheck source=tests/lanes/ownership
source tests/lanes/ownership

# 1. Every lane's tasks file runs exactly the rake tasks the table says it
#    transcribes. A lane that picks up a task (or drops one) changes what
#    paths it owns, and that has to be a table edit in the same change.
for tasks in tests/lanes/*/tasks; do
  lane="${tasks%/tasks}"
  lane="${lane##*/}"
  if [[ -z "${LANES_OWNER_TASKS[${lane}]+set}" ]]; then
    echo "[lane:selftest] FAILED: lane '${lane}' has no LANES_OWNER_TASKS row in tests/lanes/ownership" >&2
    exit 1
  fi
  have="$(grep -oE '^[[:space:]]*bundle exec rake [a-z_:]+' "${tasks}" | sed -E 's/^.*rake //' | LC_ALL=C sort -u | tr '\n' ' ' || true)"
  want="$(tr ' ' '\n' <<< "${LANES_OWNER_TASKS[${lane}]}" | grep . | LC_ALL=C sort -u | tr '\n' ' ' || true)"
  if [[ "${have}" != "${want}" ]]; then
    echo "[lane:selftest] FAILED: lane '${lane}' runs rake tasks [${have}] but tests/lanes/ownership records [${want}]" >&2
    exit 1
  fi
done
for lane in "${!LANES_OWNER_TASKS[@]}"; do
  if [[ ! -f "tests/lanes/${lane}/tasks" ]]; then
    echo "[lane:selftest] FAILED: tests/lanes/ownership records a lane '${lane}' that has no tasks file" >&2
    exit 1
  fi
done

# 2. Every spec/ and try/ directory on disk resolves to the lanes expected
#    below, and every one of them HAS an expectation: a directory nothing
#    here foresees (a new integration mode, a new try/ tree) fails until it
#    is placed. Rows are `<lanes> <pattern>`, first match wins, `shared`
#    means every lane (lanes_all), `none` means no lane runs it — the
#    tolerated ones are listed by name so a new one cannot hide among them.
declare -a own_patterns=() own_lanes=()
while read -r lanes pattern; do
  own_patterns+=("${pattern}")
  own_lanes+=("${lanes}")
done <<'ROWS'
api                                              spec/api
browser                                          tests/browser
browser                                          tests/browser/*
unit                                             spec/cli
unit                                             spec/lib
unit                                             spec/unit
shared                                           spec/support
simple,disabled,full-sqlite,full-pg-agnostic     spec/integration/all
disabled                                         spec/integration/disabled
full-sqlite,full-pg,full-pg-agnostic             spec/integration/full
simple                                           spec/integration/simple
full-sqlite,full-pg,migrations-sqlite            spec/integration/full/database_triggers/sqlite_spec.rb
full-sqlite,full-pg,migrations-pg                spec/integration/full/database_triggers/postgres_spec.rb
full-sqlite,full-pg,migrations-pg                spec/integration/full/postgres_infrastructure_spec.rb
unit                                             apps/*/*/spec
full-sqlite,full-pg                              apps/*/*/spec/integration/full/migrations/*_spec.rb
full-sqlite,full-pg,full-pg-agnostic             apps/*/*/spec/integration/full
full-mfa                                         apps/*/*/spec/integration/full_mfa
full-saml-platform                               apps/*/*/spec/integration/full_saml_platform
simple                                           apps/*/*/spec/integration/simple
none                                             apps/web/billing/spec/integration/*_spec.rb
unit                                             try/features
unit                                             try/jobs
unit                                             try/security
unit                                             try/system
unit                                             try/unit
shared                                           try/support
simple                                           try/integration/api
simple                                           try/integration/billing
simple                                           try/integration/boot
simple                                           try/integration/email
simple                                           try/integration/middleware
simple                                           try/integration/web
simple                                           try/integration/check_jobqueue_live_try.rb
simple                                           try/integration/homepage_bypass_header_integration_try.rb
simple                                           try/integration/homepage_mode_integration_try.rb
none                                             try/integration/auth
none                                             try/integration/authentication
none                                             try/integration/colonel_role_auth_try.rb
none                                             try/integration/domain_auth_enforcement_try.rb
none                                             try/api
none                                             try/disabled
none                                             try/docker
none                                             try/migrations
none                                             try/scripts
none                                             try/tasks
none                                             try/web
ROWS
all_lanes="$(lanes_all | tr '\n' ',')"
all_lanes="${all_lanes%,}"
for path in tests/browser/ tests/browser/* \
            spec/*/ spec/integration/*/ spec/integration/full/database_triggers/*_spec.rb spec/integration/full/postgres_*_spec.rb \
            apps/*/*/spec/ apps/*/*/spec/integration/*/ apps/*/*/spec/integration/*_spec.rb \
            apps/*/*/spec/integration/full/migrations/*_spec.rb \
            try/*/ try/integration/*/ try/integration/*_try.rb; do
  path="${path%/}"
  [[ "${path}" == try/integration ]] && continue  # its children have rows
  [[ "${path}" == spec/integration ]] && continue
  want=''
  for i in "${!own_patterns[@]}"; do
    # shellcheck disable=SC2053  # the row is a glob on purpose
    if [[ "${path}" == ${own_patterns[$i]} ]]; then
      want="${own_lanes[$i]}"
      break
    fi
  done
  if [[ -z "${want}" ]]; then
    echo "[lane:selftest] FAILED: no ownership expectation for '${path}': add a row here and, if a lane runs it, to tests/lanes/ownership" >&2
    exit 1
  fi
  case "${want}" in
    shared) want="${all_lanes}" ;;
    none)   want='' ;;
  esac
  got="$(lanes_for_path "${path}" | tr '\n' ',')"
  got="${got%,}"
  if [[ "${got}" != "${want}" ]]; then
    echo "[lane:selftest] FAILED: lanes_for_path '${path}' = [${got}], expected [${want}]" >&2
    exit 1
  fi
done
for lane in $(lanes_all); do
  if [[ ! -f "tests/lanes/${lane}/tasks" ]]; then
    echo "[lane:selftest] FAILED: lanes_all names '${lane}', which is not a lane" >&2
    exit 1
  fi
done
if lanes_all | grep -qx smoke; then
  echo '[lane:selftest] FAILED: lanes_all includes smoke (not parallel-safe)' >&2
  exit 1
fi

# 3. The commands. --which answers from the table alone; a lane-less --only
#    infers from it (exact single owner, or exit 64 naming the candidates);
#    run-all --changed selects through it, with the diff stubbed by
#    LANES_CHANGED_STUB and --dry-run so nothing is started. Rows are
#    `<expected exit> <argv>` for the runner, then checked outputs.
#    RSPEC_OUTPUT_FILE is unset for the same reason as in the flag rows.
while read -r want args; do
  got=0
  # shellcheck disable=SC2086  # rows are split into argv on purpose
  env -u RSPEC_OUTPUT_FILE tests/lanes/run ${args} >/dev/null 2>&1 || got=$?
  if [[ "${got}" != "${want}" ]]; then
    echo "[lane:selftest] FAILED: tests/lanes/run ${args} exited ${got}, expected ${want}" >&2
    exit 1
  fi
done <<'ROWS'
0  --which spec/api
0  --which tests/browser/saml_callback_spec.rb
0  --which lib/onetime.rb
64 --which docs
64 --which
64 --which spec/api lib
0  --only spec/unit/lanes/hermetic_boundary_spec.rb --print-key
0  --only tests/browser/saml_callback_spec.rb --print-key
0  --quiet --only spec/unit/lanes/hermetic_boundary_spec.rb --only spec/unit/lanes/run_all_spec.rb --print-key
64 --only spec/integration/full --print-key
64 --only spec/unit/lanes/hermetic_boundary_spec.rb --only spec/api --print-key
64 --only README.md --print-key
64 --print-key
64 --quiet
64 --console --print-key
64 selftest --which spec/api
64 ../selftest --print-key
64 selftest/ --print-key
64 ../../tests/lanes/selftest --print-key
ROWS
if [[ "$(tests/lanes/run --which spec/api 2>/dev/null)" != api ]]; then
  echo '[lane:selftest] FAILED: --which spec/api did not print exactly "api"' >&2
  exit 1
fi
if [[ "$(tests/lanes/run --which spec/integration/full 2>/dev/null | tr '\n' ' ')" != 'full-sqlite full-pg full-pg-agnostic ' ]]; then
  echo '[lane:selftest] FAILED: --which spec/integration/full did not list its three lanes' >&2
  exit 1
fi
# Captured, not piped through `grep -q`: a grep that exits on the first
# line leaves the runner's second line to a closed pipe, and under pipefail
# that SIGPIPE reads as a failed check — intermittently.
inferred="$(tests/lanes/run --only spec/unit/lanes/hermetic_boundary_spec.rb --print-key 2>/dev/null)"
if [[ "${inferred}" != lane=unit\ * ]]; then
  echo '[lane:selftest] FAILED: --only spec/unit/... did not infer lane=unit' >&2
  exit 1
fi
# Captured for the other reason too: the runner exits 64 here by design.
ambiguous="$(tests/lanes/run --only spec/integration/full --print-key 2>&1 >/dev/null || true)"
if [[ "${ambiguous}" != *full-sqlite*full-pg*full-pg-agnostic* ]]; then
  echo '[lane:selftest] FAILED: ambiguous --only did not list its candidates' >&2
  exit 1
fi
# Rows: `<stub paths, |-separated> <expected lane list>`; an empty list is
# a run with nothing to do, which exits 0 and plans no lane.
while read -r stub want; do
  got="$(LANES_CHANGED_STUB="${stub//|/$'\n'}" tests/lanes/run-all --dry-run --changed 2>/dev/null | sed -n 's/^\[run-all\] lanes:   //p')"
  if [[ "${got}" != "${want}" ]]; then
    echo "[lane:selftest] FAILED: run-all --changed with stub '${stub}' selected [${got}], expected [${want}]" >&2
    exit 1
  fi
done <<ROWS
spec/api/v2/x_spec.rb api
tests/browser/saml_callback.mjs browser
spec/api/v2/x_spec.rb|apps/api/v1/spec/integration/simple/x_spec.rb|docs/x.md|try/web/x_try.rb api simple
spec/integration/all/x_spec.rb disabled full-pg-agnostic full-sqlite simple
spec/api/v2/x_spec.rb|lib/onetime.rb ${all_lanes//,/ }
Gemfile.lock ${all_lanes//,/ }
tests/lanes/unit/env ${all_lanes//,/ }
docs/x.md|src/App.vue
ROWS
got=0
LANES_CHANGED_STUB='docs/x.md' tests/lanes/run-all --dry-run --changed >/dev/null 2>&1 || got=$?
if [[ "${got}" != 0 ]]; then
  echo "[lane:selftest] FAILED: run-all --changed with nothing to run exited ${got}, expected 0" >&2
  exit 1
fi
# A lane name after --changed is its base argument; one after --dry-run is
# a lane name, and --changed does not take those.
got=0
LANES_CHANGED_STUB='spec/api/v2/x_spec.rb' tests/lanes/run-all --changed --dry-run unit >/dev/null 2>&1 || got=$?
if [[ "${got}" != 64 ]]; then
  echo "[lane:selftest] FAILED: run-all --changed with a lane name exited ${got}, expected 64" >&2
  exit 1
fi
# The stub is honored only with --dry-run: without it a set stub is an
# error, so a stale shell export can never stand in for the git diff.
got=0
LANES_CHANGED_STUB='spec/api/v2/x_spec.rb' tests/lanes/run-all --changed >/dev/null 2>&1 || got=$?
if [[ "${got}" != 64 ]]; then
  echo "[lane:selftest] FAILED: run-all --changed with LANES_CHANGED_STUB and no --dry-run exited ${got}, expected 64" >&2
  exit 1
fi
echo '--- lane:selftest ownership ok ---'
