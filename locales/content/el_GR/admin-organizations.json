  "web.admin.organizations.entitlements.matrix.legend.missing": {
    "text": "Ελλείπει — αναμενόμενο αλλά μη υλοποιημένο. Αυτό είναι το δικαίωμα που λείπει πραγματικά από τα μέλη αυτή τη στιγμή.",
