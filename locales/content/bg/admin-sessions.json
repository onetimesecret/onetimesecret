  "web.admin.sessions.authority.title": {
    "text": "Не е източникът на истина за сесиите в режим на пълно удостоверяване",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Този списък е хранилището за сесии в Redis. Когато режимът на удостоверяване е зададен на full, авторитетното състояние на сесиите се намира в базата данни с акаунти на Rodauth, която тази конзола не чете. Акаунти, влезли чрез Rodauth, може да не се показват тук, а отменянето на сесия тук не прекратява сесия в Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Този списък е хранилището за сесии в Redis. Когато режимът на удостоверяване е зададен на full, авторитетното състояние на сесиите се намира в базата данни с акаунти на Rodauth, която тази конзола не чете. Акаунти, влезли чрез Rodauth, може да не се показват тук, а отменянето на отделна сесия тук не прекратява съответната ѝ сесия в Rodauth. „Отмяна на всички“ прекратява и сесиите на акаунта в Rodauth.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "Отваряне на Rodauth Admin",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "Задайте RODAUTH_ADMIN_URL, за да свържете оттук към Rodauth Admin.",
    "source_hash": "c070dbfb"
  },
  "web.admin.sessions.columns.sessionHandle": {
    "text": "Манипулатор на сесията",
    "source_hash": "2f08034d"
  },
  "web.admin.sessions.errors.scanCapped": {
    "text": "Тази сесия не е намерена в извадката от пространството с ключове. Отворете я от реда ѝ в списъка, за да може собственикът да бъде използван за търсенето ѝ.",
    "source_hash": "67b73f7f"
  },
  "web.admin.sessions.fields.sessionHandle": {
    "text": "Манипулатор на сесията",
    "source_hash": "2f08034d"
  },
  "web.admin.sessions.revoke.ownSession": {
