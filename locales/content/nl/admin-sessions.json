  "web.admin.sessions.authority.title": {
    "text": "Geen gezaghebbende sessiebron in volledige authenticatiemodus",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Deze lijst is de Redis-sessieopslag. Wanneer de authenticatiemodus op full staat, bevindt de gezaghebbende sessiestatus zich in de Rodauth-accountdatabase, die deze console niet leest. Accounts die via Rodauth zijn ingelogd, verschijnen hier mogelijk niet, en het herroepen van een sessie hier beëindigt geen Rodauth-sessie.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Deze lijst is de Redis-sessieopslag. Wanneer de authenticatiemodus op full staat, bevindt de gezaghebbende sessiestatus zich in de Rodauth-accountdatabase, die deze console niet leest. Accounts die via Rodauth zijn ingelogd, verschijnen hier mogelijk niet, en het intrekken van één sessie hier beëindigt de bijbehorende Rodauth-sessie niet. Alle intrekken beëindigt ook de Rodauth-sessies van het account.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "Rodauth Admin openen",
    "source_hash": "ce523836"
