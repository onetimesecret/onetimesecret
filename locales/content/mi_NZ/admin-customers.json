  "web.admin.customers.actions.impersonate.confirmTitle": {
    "text": "Tīmata whakaari tuakiri?",
    "source_hash": "c6e4fa74"
  },
  "web.admin.customers.actions.impersonate.confirmDescription": {
    "text": "Ka whakatuwhera i tētahi wātū pānui-anake, he tepe wā tōna, hei {email}. Ka whakaatu ia whārangi i tētahi pānui kia whakamutu rā anō koe, ka āraitia ngā huringa, ā, ka tuhia te wātū ki te rangitaki arotake me tō take.",
    "source_hash": "713c01b4"
  },
  "web.admin.customers.actions.impersonate.reasonLabel": {
    "text": "Take (e hiahiatia ana)",
    "source_hash": "d976f5d9"
  },
  "web.admin.customers.actions.impersonate.reasonPlaceholder": {
    "text": "He aha e hiahiatia ai tēnei wātū? Tāpirihia te tohutoro tīkiti.",
    "source_hash": "89a4835d"
  },
  "web.admin.customers.actions.impersonate.success": {
    "text": "Kua tīmata te whakaari tuakiri.",
    "source_hash": "b4662bcc"
  },
  "web.admin.customers.actions.impersonate.unavailable": {
    "text": "Kāore e wātea te whakaari tuakiri mō ngā pūkete Colonel, ingoakore, kua whakatārewatia rānei.",
    "source_hash": "fb6578b2"
  },
  "web.admin.customers.actions.purge.refused": {
    "text": "Kua whakakāhoretia te horoi. I tiakina te kiritaki; whakatauhia ngā ārai i mua i te ngana anō.",
    "source_hash": "8e8a2ae1"
  },
  "web.admin.customers.actions.purge.partial": {
    "text": "I mutu te horoi i muri i te otinga o ētahi whakapaipai. Kaua e pūrongo he angitu, kaua hoki e ngana anō mā te matapō; arotakehia ngā wāhanga kua oti me ngā ārai.",
    "source_hash": "a88fd15b"
  },
  "web.admin.customers.actions.purge.incomplete": {
    "text": "Kāore i oti te horoi (tūnga: {status}). Arotakehia ngā taipitopito huringa-ora i mua i te ngana anō.",
    "source_hash": "c0c3d287"
  },
  "web.admin.customers.actions.purge.unreadableResult": {
    "text": "I whakahoki mai te tūmau i tētahi otinga horoi kāore e taea te pānui. Kāore he angitu i pūrongotia; manatokohia te tūnga o te kiritaki me te Wāhi Mahi i mua i te ngana anō.",
    "source_hash": "cc837a77"
  },
  "web.admin.customers.actions.purge.resultStage": {
    "text": "I mutu i te wāhanga: {stage}.",
    "source_hash": "d0e313bf"
