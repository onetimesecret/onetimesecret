    "text": "Panoni tūranga",
    "source_hash": "a43a8d8c"
  },
  "web.admin.customers.actions.role.selfDemote": {
    "text": "Kāore e taea e koe te whakaheke i tō ake pūkete Colonel. Tonoa tētahi atu Colonel kia mahi, whakahaerehia rānei te `bin/ots customers role demote`.",
    "source_hash": "3e75d01b"
  },
  "web.admin.customers.actions.role.lastColonel": {
    "text": "Kāore e taea e koe te whakaheke i te Colonel whakamutunga e toe ana — ka kore he kaiwhakahaere o te tāutanga. Whakapikihia, manatokohia hoki tētahi atu pūkete i te tuatahi.",
    "source_hash": "9c59c731"
  },
  "web.admin.customers.actions.unverify.selfUnverify": {
    "text": "Kāore e taea e koe te whakakore i te manatoko o tō ake pūkete: me whai īmēra kua manatokona kia pupuri ai i te tūranga Colonel.",
    "source_hash": "8ab024fe"
  },
  "web.admin.customers.actions.unverify.lastColonel": {
    "text": "Kāore e taea e koe te whakakore i te manatoko o te Colonel whakamutunga e toe ana — kāore e taea e tētahi pūkete kāore anō kia manatokona te pupuri i te tūranga Colonel. Whakapikihia, manatokohia hoki tētahi atu pūkete i te tuatahi.",
    "source_hash": "fc404616"
  },
  "web.admin.customers.detail.diagnostics.organizationContextBlocked": {
    "text": "Kua āraitia, kāore rānei i oti te horopaki whakahaere. Tirohia te Wāhi Mahi kua taupūtia, ā, whakatikaina te rerenga kē o te taupū rangatiratanga, mematanga, īmēra whakapā rānei i mua i te kī he ora tēnei pūkete.",
    "source_hash": "5c5c89be"
