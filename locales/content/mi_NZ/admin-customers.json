  "web.admin.customers.detail.sessions.revokeAll.selfDescription": {
    "text": "Ka takiputa tēnei i a koe mai i ia atu pūrere me ia atu pūtirotiro, tae atu ki ngā wātū kāore i te whakaaturia i tēnei rārangi. Ka puritia te wātū e mahi nei koe ināianei.",
    "source_hash": "ae350040"
  },
  "web.admin.customers.list.capped": {
    "text": "Kua tepea ngā hua: ko te tatau e whakaaturia ana he papa, ehara i te tapeke. Whakaitihia te rapunga, te tātari rānei kia kite ai i ngā mea katoa.",
    "source_hash": "27537844"
  },
  "web.admin.customers.list.orphanedAccounts.title": {
    "text": "He pūkete pātengi raraunga motuhēhē kāore he rekoata kiritaki",
