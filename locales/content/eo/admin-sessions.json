  "web.admin.sessions.authority.title": {
    "text": "Ne la seanca aŭtoritato en plena aŭtentikiga reĝimo",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Ĉi tiu listo estas la Redis-seanca konservejo. Kiam la aŭtentikiga reĝimo estas agordita al full, la aŭtoritata seanca stato troviĝas en la Rodauth-kontodatumbazo, kiun ĉi tiu konzolo ne legas. Kontoj ensalutintaj per Rodauth eble ne aperas ĉi tie, kaj revoki seancon ĉi tie ne finas Rodauth-seancon.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Ĉi tiu listo estas la Redis-seanca konservejo. Kiam la aŭtentikiga reĝimo estas agordita al full, la aŭtoritata seanca stato troviĝas en la Rodauth-kontodatumbazo, kiun ĉi tiu konzolo ne legas. Kontoj ensalutintaj per Rodauth eble ne aperas ĉi tie, kaj revoki unuopan seancon ĉi tie ne finas ĝian Rodauth-seancon. “Revoki ĉiujn” ankaŭ finas la Rodauth-seancojn de la konto.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "Malfermi Rodauth Admin",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "Agordu RODAUTH_ADMIN_URL por ligi al Rodauth Admin de ĉi tie.",
    "source_hash": "c070dbfb"
  },
