  "web.admin.customers.actions.purge.partial": {
    "text": "Forviŝado haltis post kiam parto de la purigado finiĝis. Ne raportu sukceson kaj ne reprovu blinde; revizu la finitajn etapojn kaj blokilojn.",
    "source_hash": "a88fd15b"
  },
  "web.admin.customers.actions.purge.incomplete": {
