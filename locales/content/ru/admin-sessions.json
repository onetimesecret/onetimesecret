  "web.admin.sessions.authority.title": {
    "text": "Не основной источник сессий в полном режиме аутентификации",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Этот список — хранилище сессий Redis. Когда задан полный режим аутентификации, основное состояние сессий хранится в базе данных аккаунтов Rodauth, которую эта консоль не читает. Аккаунты, вошедшие через Rodauth, могут здесь не отображаться, а отзыв сессии здесь не завершает сессию Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Этот список — хранилище сессий Redis. Когда задан полный режим аутентификации, основное состояние сессий хранится в базе данных аккаунтов Rodauth, которую эта консоль не читает. Аккаунты, вошедшие через Rodauth, могут здесь не отображаться, а отзыв отдельной сессии здесь не завершает её сессию Rodauth. «Отозвать все» также завершает сессии Rodauth этого аккаунта.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "Открыть Rodauth Admin",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "Задайте RODAUTH_ADMIN_URL, чтобы отсюда можно было перейти в Rodauth Admin.",
    "source_hash": "c070dbfb"
  },
  "web.admin.sessions.columns.sessionHandle": {
