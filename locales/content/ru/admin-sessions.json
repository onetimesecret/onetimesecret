    "source_hash": "2f08034d"
  },
  "web.admin.sessions.errors.scanCapped": {
    "text": "Эта сессия не найдена в просканированной выборке ключей. Откройте её из строки в списке, чтобы для поиска можно было использовать владельца.",
    "source_hash": "67b73f7f"
  },
  "web.admin.sessions.fields.sessionHandle": {
    "text": "Дескриптор сессии",
    "source_hash": "2f08034d"
  },
  "web.admin.sessions.revoke.ownSession": {
