  "web.admin.sessions.authority.title": {
    "text": "No és la font autoritzada de sessions en el mode d'autenticació complet",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Aquesta llista és el magatzem de sessions de Redis. Amb el mode d'autenticació complet, l'estat autoritzat de les sessions es troba a la base de dades de comptes de Rodauth, que aquesta consola no llegeix. És possible que els comptes que han iniciat la sessió mitjançant Rodauth no apareguin aquí, i revocar una sessió aquí no finalitza cap sessió de Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Aquesta llista és el magatzem de sessions de Redis. Amb el mode d'autenticació complet, l'estat autoritzat de les sessions es troba a la base de dades de comptes de Rodauth, que aquesta consola no llegeix. És possible que els comptes que han iniciat la sessió mitjançant Rodauth no apareguin aquí, i revocar una sola sessió aquí no finalitza la seva sessió de Rodauth. «Revoca-les totes» també finalitza les sessions de Rodauth del compte.",
    "source_hash": "f964663d"
  },
