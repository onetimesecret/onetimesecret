    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Ez a lista a Redis-munkamenettárolót mutatja. Ha a hitelesítési mód teljesre (full) van állítva, a mérvadó munkamenet-állapot a Rodauth fiókadatbázisában található, amelyet ez a konzol nem olvas. A Rodauth-on keresztül bejelentkezett fiókok nem feltétlenül jelennek meg itt, és egy munkamenet itteni visszavonása nem szünteti meg a Rodauth-munkamenetet.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Ez a lista a Redis-munkamenettárolót mutatja. Ha a hitelesítési mód teljesre (full) van állítva, a mérvadó munkamenet-állapot a Rodauth fiókadatbázisában található, amelyet ez a konzol nem olvas. A Rodauth-on keresztül bejelentkezett fiókok nem feltétlenül jelennek meg itt, és egyetlen munkamenet itteni visszavonása nem szünteti meg a hozzá tartozó Rodauth-munkamenetet. Az összes visszavonása a fiók Rodauth-munkameneteit is megszünteti.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "Rodauth Admin megnyitása",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "Állítsa be a RODAUTH_ADMIN_URL értékét, hogy innen a Rodauth Adminra hivatkozhasson.",
    "source_hash": "c070dbfb"
  },
