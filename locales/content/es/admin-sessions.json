    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Esta lista es el almacén de sesiones de Redis. Con el modo de autenticación establecido en completo, el estado autoritativo de las sesiones reside en la base de datos de cuentas de Rodauth, que esta consola no lee. Es posible que las cuentas que iniciaron sesión mediante Rodauth no aparezcan aquí, y revocar una sesión aquí no finaliza una sesión de Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Esta lista es el almacén de sesiones de Redis. Con el modo de autenticación establecido en completo, el estado autoritativo de las sesiones reside en la base de datos de cuentas de Rodauth, que esta consola no lee. Es posible que las cuentas que iniciaron sesión mediante Rodauth no aparezcan aquí, y revocar una sola sesión aquí no finaliza su sesión de Rodauth. Revocar todas también finaliza las sesiones de Rodauth de la cuenta.",
    "source_hash": "f964663d"
  },
