  "web.admin.sessions.authority.title": {
    "text": "אינו מקור הסמכות להפעלות במצב אימות מלא",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "רשימה זו היא מאגר ההפעלות של Redis. כאשר מצב האימות מוגדר ל-full, מצב ההפעלות המוסמך נמצא במסד נתוני החשבונות של Rodauth, שקונסולה זו אינה קוראת. חשבונות שהתחברו דרך Rodauth עשויים שלא להופיע כאן, וביטול הפעלה כאן אינו מסיים הפעלת Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "רשימה זו היא מאגר ההפעלות של Redis. כאשר מצב האימות מוגדר ל-full, מצב ההפעלות המוסמך נמצא במסד נתוני החשבונות של Rodauth, שקונסולה זו אינה קוראת. חשבונות שהתחברו דרך Rodauth עשויים שלא להופיע כאן, וביטול הפעלה בודדת כאן אינו מסיים את הפעלת ה-Rodauth שלה. בטל הכל מסיים גם את הפעלות ה-Rodauth של החשבון.",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "פתח את Rodauth Admin",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "הגדר את RODAUTH_ADMIN_URL כדי לקשר ל-Rodauth Admin מכאן.",
    "source_hash": "c070dbfb"
  },
  "web.admin.sessions.columns.sessionHandle": {
    "text": "ידית הפעלה",
    "source_hash": "2f08034d"
  },
  "web.admin.sessions.errors.scanCapped": {
    "text": "הפעלה זו לא נמצאה במרחב המפתחות שנדגם. פתח אותה מהשורה שלה ברשימה, כך שניתן יהיה לאתר אותה לפי הבעלים שלה.",
    "source_hash": "67b73f7f"
  },
  "web.admin.sessions.fields.sessionHandle": {
