  "web.admin.sessions.authority.title": {
    "text": "在完整身份验证模式下，此处并非会话的权威来源",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "此列表来自 Redis 会话存储。当身份验证模式设置为 full 时，权威的会话状态保存在 Rodauth 账户数据库中，而此控制台不会读取该数据库。通过 Rodauth 登录的账户可能不会显示在此处，并且在此处撤销会话不会结束 Rodauth 会话。",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "此列表来自 Redis 会话存储。当身份验证模式设置为 full 时，权威的会话状态保存在 Rodauth 账户数据库中，而此控制台不会读取该数据库。通过 Rodauth 登录的账户可能不会显示在此处，并且在此处撤销单个会话不会结束其 Rodauth 会话。「撤销全部」还会结束该账户的 Rodauth 会话。",
    "source_hash": "f964663d"
  },
  "web.admin.sessions.authority.openAdmin": {
    "text": "打开 Rodauth Admin",
    "source_hash": "ce523836"
  },
  "web.admin.sessions.authority.notConfigured": {
    "text": "设置 RODAUTH_ADMIN_URL 后，即可从此处链接到 Rodauth Admin。",
