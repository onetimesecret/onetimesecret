  "web.admin.sessions.authority.title": {
    "text": "Không phải nguồn phiên có thẩm quyền trong chế độ xác thực đầy đủ",
    "source_hash": "796fb07f"
  },
  "web.admin.sessions.authority.description": {
    "text": "Danh sách này là kho lưu trữ phiên Redis. Khi chế độ xác thực được đặt là full, trạng thái phiên có thẩm quyền nằm trong cơ sở dữ liệu tài khoản Rodauth, mà bảng điều khiển này không đọc. Các tài khoản đăng nhập qua Rodauth có thể không xuất hiện ở đây, và việc thu hồi một phiên ở đây không kết thúc phiên Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Danh sách này là kho lưu trữ phiên Redis. Khi chế độ xác thực được đặt là full, trạng thái phiên có thẩm quyền nằm trong cơ sở dữ liệu tài khoản Rodauth, mà bảng điều khiển này không đọc. Các tài khoản đăng nhập qua Rodauth có thể không xuất hiện ở đây, và việc thu hồi một phiên riêng lẻ ở đây không kết thúc phiên Rodauth của nó. Thu hồi tất cả cũng sẽ kết thúc các phiên Rodauth của tài khoản.",
    "source_hash": "f964663d"
  },
