  "web.admin.sessions.authority.description": {
    "text": "Ta seznam je shramba sej Redis. Ko je način avtentikacije nastavljen na full, je avtoritativno stanje sej v podatkovni bazi računov Rodauth, ki je ta konzola ne bere. Računi, prijavljeni prek Rodauth, tukaj morda niso prikazani, preklic seje tukaj pa ne konča seje Rodauth.",
    "source_hash": "77bc4904"
  },
  "web.admin.sessions.authority.descriptionRevokeAll": {
    "text": "Ta seznam je shramba sej Redis. Ko je način avtentikacije nastavljen na full, je avtoritativno stanje sej v podatkovni bazi računov Rodauth, ki je ta konzola ne bere. Računi, prijavljeni prek Rodauth, tukaj morda niso prikazani, preklic posamezne seje tukaj pa ne konča njene seje Rodauth. Možnost „Prekliči vse“ konča tudi seje Rodauth tega računa.",
    "source_hash": "f964663d"
  },
