# .env.test.example — template for running the test suite
#
# Copy to .env.test (bin/setup --test does this for you) and fill in only what
# you need. Most tests need NOTHING here:
#
#   - The RSpec unit/fast suites force RACK_ENV=test in spec/spec_helper.rb and
#     read spec/config.test.yaml, which hardcodes its secrets and the datastore
#     URI (redis://127.0.0.1:2163/0). bin/setup --test (or tests/lanes/run)
#     starts the test service containers from compose.test.yml.
#   - Vitest needs no database at all.
#
# The variables below are ONLY required for the PostgreSQL-backed integration
# tests (rake spec:integration:full:postgres). Leave them blank/commented to
# run the unit suites without Postgres.

# Informational: spec_helper.rb sets this itself; direnv lanes also read it.
RACK_ENV=test

# ─── PostgreSQL integration tests (optional) ─────────────────────────
# No superuser URL or manual provisioning needed: the postgres container
# (compose.test.yml, port 2154) runs initialize_test_db.sql via initdb on
# first boot, creating the test database and the least-privilege roles below.

# Runtime (DML-only) and migration (DDL) connections the integration tests use.
# These match the roles created by initialize_test_db.sql. The lane env files
# (tests/lanes/full-pg*/env) already set these; only set them here for ad-hoc
# work outside the lane runner.
#AUTH_DATABASE_URL=postgresql://onetime_user:testpass@127.0.0.1:2154/onetime_auth_test
#AUTH_DATABASE_URL_MIGRATIONS=postgresql://onetime_migrator:migratepass@127.0.0.1:2154/onetime_auth_test
