# Onetime Secret - Quick Start Configuration
#
# For bare-metal / tarball installs:
#   1. Run bin/setup --init      (copies this file to .env and generates secrets)
#   2. Source environment:        set -a; source .env; set +a
#   3. Start the app:            bundle exec puma -C etc/puma.rb
#
# For Docker:
#   1. docker compose up         (compose files set their own env overrides)
#
# See the YAML configs in etc/defaults for complete reference.

# --- Root Secret --------------------------------------------
# The single root secret. All other cryptographic material is
# derived from this via HKDF (RFC 5869). Back this up.
# Generated automatically by `bin/setup --init`.
SECRET=

# Obfuscates numeric account IDs in email-verification
# links and remember-me cookies. Required for full-auth
# production. Generated automatically by `bin/setup --init`;
# leave blank so a copied file never ships a known secret.
ACCOUNT_ID_SECRET=

# --- Connections --------------------------------------------
# Default: local/bare-metal. Docker Compose overrides this
# via environment settings in docker/compose/*.yml.
REDIS_URL='redis://127.0.0.1:6379/0'

# --- Site Identity ------------------------------------------
# Your public hostname. Include port if non-standard.
HOST=localhost:3000
# Both shipped Docker Compose stacks terminate TLS at the edge (Caddy on
# 80/443), so the app is served over HTTPS. Keep SSL=true so the session
# cookie ships with the Secure flag.
SSL=true
# Set SSL=false ONLY for bare-metal plain-HTTP development on localhost.
# In production SSL=false no longer disables Secure (the app fails closed and
# forces it on), so a genuinely non-HTTPS production origin would not receive
# session cookies at all — put TLS in front of it instead, or if plain HTTP
# is truly intended, set the explicit override SESSION_COOKIE_SECURE=false.


# --- Email Delivery -----------------------------------------
# Required for account verification and secret notifications.
# Leave blank to disable outbound email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

FROM_EMAIL=secure@example.com
FROM_NAME="Secret Links"


# --- Incoming Secrets ---------------------------------------
# A destination page where users submit secret links directly to a
# preconfigured email address. i.e. /incoming
#INCOMING_ENABLED=false

# --- Secret Privacy -----------------------------------------
# Available TTL choices (space-separated, in seconds)
# Default: 300 3600 86400 604800 (5m, 1h, 1d, 7d)
#TTL_OPTIONS=

# Max TTL for secrets created without an account. Default: 604800 (7 days).
# Raise or lower it freely — the effective ceiling is the lower of this and the
# TTL_OPTIONS maximum.
#TTL_MAX_ANONYMOUS=604800

# Disable user authentication (enabled by default; set to false to disable)
#AUTH_ENABLED=false

# --- Docker Compose -----------------------------------------
# App image tag used by docker/compose/*.yml. Defaults to the pinned
# release documented in the README quick start. Uncomment to override.
#OTS_IMAGE_TAG=v0.25.11

# Background jobs (full stack only). Unset/false: worker-email and
# scheduler stay idle and email is sent synchronously by the web process.
# true: the web app publishes jobs to RabbitMQ and workers consume them.
# See docker/README.md for details.
#JOBS_ENABLED=true


#-----BEGIN DERIVED SECRETS (from SECRET via HKDF)-----
#SESSION_SECRET=
#IDENTIFIER_SECRET=
#-----END DERIVED SECRETS-----

#-----BEGIN INDEPENDENT SECRETS (generated, must be backed up)-----
#AUTH_SECRET=
#ARGON2_SECRET=
# Also keys the pseudonymous Sentry diagnostics references: Sentry receives an
# opaque keyed digest of the customer external identifier (and of the
# organization objid), never the identifier itself. Per-installation by
# construction — do not copy between installations. Rotating this re-keys the
# references; with no secret set, none are emitted. See .env.reference and
# docs/development/{backend,frontend}-diagnostics.md.
#ACCOUNT_ID_SECRET=
#-----END INDEPENDENT SECRETS-----

#-----BEGIN FEDERATION (shared across instances, auto-generated passphrase)-----
#FEDERATION_SECRET=
#-----END FEDERATION-----
