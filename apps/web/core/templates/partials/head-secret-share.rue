<template>
  <!-- Include base head tags -->
  {{> partials/head-base}}

  <!-- Open Graph meta tags for secret sharing -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{page_url}}">
  <meta property="og:title" content="{{og_title}}">
  <meta property="og:description" content="{{og_description}}">
  <!-- No preview image: a secret page carries no brand of its own, and an
       install image on a custom domain would be the wrong brand. -->

  <!-- Twitter Card meta tags -->
  <meta name="twitter:card" content="summary">
  <meta property="twitter:domain" content="{{display_domain}}">
  <meta property="twitter:url" content="{{page_url}}">
  <meta name="twitter:title" content="{{og_title}}">
  <meta name="twitter:description" content="{{og_description}}">

  <!-- Secret pages are never indexed. robots.rue disallows the prefixes as
       well, but a disallow only stops crawling; noindex stops listing. -->
  <meta name="robots" content="noindex, nofollow">
</template>
